# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# SECRETS / SERVER-SIDE ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Secrets (Server-side database persistence)
# SUPABASE_URL: Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=
# SUPABASE_SECRET_KEY: Secret key for server-side database operations (SERVICE_ROLE or SECRET key)
# NEVER expose this key to client-side code or prefix with VITE_
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY: Alternative Supabase service role secret key
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY: Optional public anon key fallback
SUPABASE_ANON_KEY=

# Admin Authentication Secret
# ADMIN_SECRET_KEY: Secret token / PIN for protecting the baker admin panel and order updates
ADMIN_SECRET_KEY=

# Session / JWT Secret
# SESSION_SECRET: Secret phrase used for encrypting session tokens or checkout orders
SESSION_SECRET=

# South African Payment Gateway Secrets (Optional integrations)
# PAYFAST_MERCHANT_ID: PayFast merchant ID for South African ZAR card and Instant EFT
PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY: PayFast merchant secret key
PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE: PayFast salt passphrase
PAYFAST_PASSPHRASE=

# YOCO_SECRET_KEY: Yoco online payments secret key (format: sk_live_... or sk_test_...)
YOCO_SECRET_KEY=

# WhatsApp Cloud API Secret (Optional order notifications)
# WHATSAPP_API_TOKEN: Bearer token for WhatsApp Cloud API alerts
WHATSAPP_API_TOKEN=

# ==============================================================================
# CLIENT-SIDE PUBLIC VARIABLES (Safe for browser / Vite)
# ==============================================================================
# Client-side Supabase variables (used ONLY for public read queries or GitHub Pages static builds)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

